# =============================================================================
# n8n-hubspot-deal-executive-summary-slack-war-room-builder :: env template
# -----------------------------------------------------------------------------
# Copy to .env (git-ignored) or set in your n8n host / container / secret
# manager. Every value is a PLACEHOLDER. Never commit real values.
#
# SAFE BY DEFAULT: leaving this file untouched keeps the workflow in
# SANDBOX_MODE: zero external API calls, zero Slack channels, zero CRM updates.
# =============================================================================

# ---- n8n runtime --------------------------------------------------------------
# Lets {{ $env.X }} work in expressions and Code nodes. If n8n blocks env
# access, the workflow falls back to sandbox defaults instead of failing open.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=UTC

# ---- Safety switches (safe defaults shown) ----------------------------------
# Safe-ON: turn off only with an explicit false/0/no/off.
SANDBOX_MODE=true
DRY_RUN=true
# Safe-OFF: turn on only with an explicit true/1/yes/on.
SLACK_MUTATIONS_ENABLED=false
HUBSPOT_MUTATIONS_ENABLED=false
AI_ENABLED=false
# Slack provisioning is refused while HubSpot stamping is off (idempotency).
# Set true only if you accept the risk of duplicate channels.
ALLOW_SLACK_WITHOUT_HUBSPOT_STAMP=false

# ---- Threshold & eligibility --------------------------------------------------
ARR_THRESHOLD=50000
# Deal property compared with the threshold: amount, hs_arr, hs_acv or a custom one.
ARR_PROPERTY=amount
THRESHOLD_CURRENCY=USD
ALLOW_CURRENCY_MISMATCH=false
# Empty = any pipeline / any stage not excluded.
ELIGIBLE_PIPELINES=
ELIGIBLE_DEAL_STAGES=
EXCLUDED_DEAL_STAGES=closedwon,closedlost
# Webhook propertyChange events for other properties are ignored.
TRIGGER_PROPERTIES=amount,dealstage,hs_arr,hs_acv,pipeline
# Optional display names for custom stage IDs: id:Label,id:Label
DEAL_STAGE_LABELS=

# ---- HubSpot ------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=
# Numeric portal ID. 99000001 is the synthetic sandbox placeholder.
HUBSPOT_PORTAL_ID=99000001
HUBSPOT_API_BASE_URL=https://api.hubapi.com
# EU-hosted portals: https://app-eu1.hubspot.com
HUBSPOT_APP_BASE_URL=https://app.hubspot.com
# Custom deal properties the stamp writes (create them first, see README).
HUBSPOT_STAMP_CHANNEL_ID_PROPERTY=war_room_slack_channel_id
HUBSPOT_STAMP_CHANNEL_URL_PROPERTY=war_room_slack_channel_url
HUBSPOT_STAMP_CREATED_AT_PROPERTY=war_room_created_at
# Deal used by the Manual Test Trigger in live mode.
TEST_DEAL_ID=
MAX_CONTACTS=50
MAX_ENGAGEMENTS_PER_TYPE=10
BRIEF_INCLUDE_CONTACT_NAMES=true

# ---- Webhook ------------------------------------------------------------------
# 16+ random characters. Send as header x-war-room-secret, or as
# ?war_room_secret= on the target URL for HubSpot app webhook subscriptions.
WEBHOOK_SHARED_SECRET=
MAX_DEALS_PER_EXECUTION=10

# ---- Slack --------------------------------------------------------------------
# Bot User OAuth token from your Slack app (Settings > Install App).
SLACK_BOT_TOKEN=
SLACK_API_BASE_URL=https://slack.com/api
# Used for channel links stamped on the deal.
SLACK_WORKSPACE_URL=https://example-workspace.slack.com
CHANNEL_PREFIX=deal-
CHANNEL_PRIVATE=true
SLUG_STRIP_LEGAL_SUFFIXES=true
INVITE_DEAL_OWNER=true
# Comma-separated Slack user IDs and/or emails (resolved via users.lookupByEmail).
LEADERSHIP_SLACK_USER_IDS=U99000001
LEADERSHIP_EMAILS=cro@example.com,vp.sales@example.com
MAX_INVITEES=25
IDEMPOTENCY_LOCK_TTL_MINUTES=30

# ---- Optional AI synthesis (OpenAI-compatible /chat/completions) ---------------
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
# Required when AI_ENABLED=true. No default, so a retired model is never used silently.
AI_MODEL=
AI_JSON_MODE=true
AI_INCLUDE_CONTACT_NAMES=false
AI_MAX_INPUT_CHARS=6000

# ---- Testing ------------------------------------------------------------------
# Pins "now" (ISO 8601) for reproducible runs.
NOW_OVERRIDE=

